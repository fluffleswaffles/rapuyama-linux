// generated by tools/e5-xkb.py, do not edit
// the E5 layers for weston (keymap_layout=e5); /etc/e5.xkb is the X version
default partial alphanumeric_keys modifier_keys
xkb_symbols "basic" {
	include "us(basic)"
	name[Group1] = "English (Nokia E5)";
	// level 5 (Fn) on Mod3, as in e5.xkb
	key <LVL5> { [ ISO_Level5_Shift ] };
	modifier_map Mod3 { <LVL5> };
	// fn (bottom left): the Fn layer for one key
	key <RCTL> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ ISO_Level5_Latch ],
		actions[Group1] = [ LatchMods(modifiers=LevelFive,clearLocks) ] };
	// sym: the printed symbols, held or one-shot
	key <RALT> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ ISO_Level3_Latch ] };
	// right soft key: Ctrl for one key
	key <LWIN> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ Control_L ],
		actions[Group1] = [ LatchMods(modifiers=Control,clearLocks) ] };
	// mail: no pointer mode under weston
	key <CAPS> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ VoidSymbol ] };
	key <AB01> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ z, Z, z, z, asciitilde, asciitilde, NoSymbol, NoSymbol ] };
	key <AB02> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ x, X, x, x, grave, grave, NoSymbol, NoSymbol ] };
	key <AB03> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ c, C, c, c, backslash, backslash, NoSymbol, NoSymbol ] };
	key <AB04> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ v, V, 7, 7, bar, bar, NoSymbol, NoSymbol ] };
	key <AB05> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ b, B, 8, 8, braceleft, braceleft, NoSymbol, NoSymbol ] };
	key <AB06> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ n, N, 9, 9, braceright, braceright, NoSymbol, NoSymbol ] };
	key <AB07> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ m, M, 0, 0, m, m, NoSymbol, NoSymbol ] };
	key <AB08> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ comma, comma, semicolon, semicolon, F11, F11, NoSymbol, NoSymbol ] };
	key <AB09> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ period, period, colon, colon, F12, F12, NoSymbol, NoSymbol ] };
	key <AB10> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ question, question, exclam, exclam, question, question, NoSymbol, NoSymbol ] };
	key <AC01> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ a, A, a, a, ampersand, ampersand, NoSymbol, NoSymbol ] };
	key <AC02> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ s, S, s, s, dollar, dollar, NoSymbol, NoSymbol ] };
	key <AC03> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ d, D, d, d, percent, percent, NoSymbol, NoSymbol ] };
	key <AC04> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ f, F, 4, 4, asciicircum, asciicircum, NoSymbol, NoSymbol ] };
	key <AC05> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ g, G, 5, 5, underscore, underscore, NoSymbol, NoSymbol ] };
	key <AC06> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ h, H, 6, 6, less, less, NoSymbol, NoSymbol ] };
	key <AC07> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ j, J, numbersign, numbersign, greater, greater, NoSymbol, NoSymbol ] };
	key <AC08> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ k, K, minus, minus, bracketleft, bracketleft, NoSymbol, NoSymbol ] };
	key <AC09> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ l, L, apostrophe, apostrophe, bracketright, bracketright, NoSymbol, NoSymbol ] };
	key <AD01> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ q, Q, quotedbl, quotedbl, F1, F1, NoSymbol, NoSymbol ] };
	key <AD02> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ w, W, parenleft, parenleft, F2, F2, NoSymbol, NoSymbol ] };
	key <AD03> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ e, E, parenright, parenright, F3, F3, NoSymbol, NoSymbol ] };
	key <AD04> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ r, R, 1, 1, F4, F4, NoSymbol, NoSymbol ] };
	key <AD05> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ t, T, 2, 2, F5, F5, NoSymbol, NoSymbol ] };
	key <AD06> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ y, Y, 3, 3, F6, F6, NoSymbol, NoSymbol ] };
	key <AD07> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ u, U, asterisk, asterisk, F7, F7, NoSymbol, NoSymbol ] };
	key <AD08> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ i, I, plus, plus, F8, F8, NoSymbol, NoSymbol ] };
	key <AD09> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ o, O, equal, equal, F9, F9, NoSymbol, NoSymbol ] };
	key <AD10> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ p, P, p, p, F10, F10, NoSymbol, NoSymbol ] };
	key <BKSP> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ BackSpace, BackSpace, BackSpace, BackSpace, Delete, Delete, NoSymbol, NoSymbol ] };
	key <DOWN> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ Down, Down, Down, Down, Next, Next, NoSymbol, NoSymbol ] };
	key <LEFT> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ Left, Left, Left, Left, Home, Home, NoSymbol, NoSymbol ] };
	key <RGHT> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ Right, Right, Right, Right, End, End, NoSymbol, NoSymbol ] };
	key <TLDE> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ at, at, slash, slash, at, at, NoSymbol, NoSymbol ] };
	key <UP> { type[Group1] = "EIGHT_LEVEL", symbols[Group1] = [ Up, Up, Up, Up, Prior, Prior, NoSymbol, NoSymbol ] };
};
