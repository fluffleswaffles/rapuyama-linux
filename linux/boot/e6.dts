/dts-v1/;

/* device tree for the nokia e6 (rapuyama, arm1176jzf-s r0p4, armv6k)
 *
 * peripheral addresses + register layouts are reversed from the firmware
 * drivers (karap/ekern/power.dll), see docs/driver-re.md. ram ends at
 * 0x20000000, everything from there up is mmio, NOT reserved dram like i thought
 * before. The booter leaves this fixed RAM range unchanged; the kernel is
 * configured with PHYS_OFFSET=0x11600000 to match it
 */

/ {
	compatible = "nokia,e6", "nokia,rapuyama";
	model = "Nokia E6-00 (RapuYama)";
	#address-cells = <1>;
	#size-cells = <1>;
	interrupt-parent = <&intc>;

	chosen {
		/* console = the bluetooth uart over the N8 test pads J6354 (our tx)
		 * / J6355 (our rx), 1.8 V! switch bluetooth on in symbian first so
		 * the block is powered/clocked/muxed. panic=10 + the pmic watchdog
		 * bring the phone back to symbian if it dies */
		bootargs = "earlycon=ramcon,0x1f000000 keep_bootcon console=ttyNULL panic=10 initcall_debug ignore_loglevel nohlt";
		stdout-path = &uart_bt;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		cpu@0 {
			device_type = "cpu";
			compatible = "arm,arm1176jzf-s";
			reg = <0>;
		};
	};

	/* NOT all 256 mb: the bottom of ram belongs to the modem. the flash toc
	 * (core image file 0x140000, entries {flash off, size, -, -, load phys,
	 * name}) has nloader load the cellular firmware into dram:
	 *   SOS*DSP0  -> 0x10200000 +0x280000 (bb5 header CDSP)
	 *   SOS*ISASW -> 0x10480000 +0x300000 (bb5 header CMCU, the modem mcu sw)
	 *   PRIMAPP/NPC/CCC/HWC/LDSP/GENIO_INIT... -> 0x108c0000..0x10900000
	 * the modem runs from there for as long as the phone is on. with
	 * PHYS_OFFSET=0x10000000 the decompressor wrote the Image over all of it
	 * (0x10008000..0x11083820) -> the modem ran on until it hit bytes and
	 * reset the soc, the random 50-210 s death. symbian maps 0x10480000 in its
	 * hw window (c6200000), that was never a framebuffer.
	 * so linux starts at 0x11600000: above all of that and above shm@11525000,
	 * 2 mb aligned for ARM_PATCH_PHYS_VIRT. costs 22 mb */
	memory@11600000 {
		device_type = "memory";
		reg = <0x11600000 0x0ea00000>;
	};

	/* RAM earlycon buffer (earlycon=ramcon,0x1f000000). linux writes all printk
	 * here from the very start of setup_arch; survives the warm watchdog reset;
	 * driver/ramread.sis reads it back. reserved so the allocator keeps off it */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		ramcon@1f000000 {
			reg = <0x1f000000 0x100000>;
			no-map;
		};

		/* ram symbian maps in its 0xc6 hw window next to the mmio (unfiltered
		 * sweep, logs/map (3).bin), so it's shared with something that isn't
		 * the arm: modem / secure side (power.dll + secldd use 0x1ffe8000 and
		 * 0x1ffec000). that something can keep writing after the jump, and
		 * linux used to put its first allocations right there (memblock
		 * hands out the top of ram first: vectors page, page tables). keep
		 * off them. mach-rapuyama watches them and logs any page that changes.
		 * NOT no-map: a no-map hole at the top of ram / off a 2 mb boundary
		 * makes arm (no highmem) drop all ram above 0x11400000 -> oom.
		 * 0x11525000 +0x2000 is below PHYS_OFFSET now, outside linux ram, so
		 * no node for it (a reserved node below PHYS_OFFSET breaks paging_init) */
		shm@1f8b0000 {
			reg = <0x1f8b0000 0x44d000>;
		};

		shm@1ffe0000 {
			reg = <0x1ffe0000 0x20000>;
		};
	};

	/* ULPI phy inside the Gazoo asic, symbian leaves it set up */
	usb_phy: usb-phy {
		compatible = "usb-nop-xceiv";
		#phy-cells = <0>;
	};

	clocks {
		/* 0x0249f000 all over the firmware */
		ref_clk: ref-clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <38400000>;
		};
		/* NKern::FastCounterFrequency() returns 0x8000 */
		fc_clk: fc-clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <32768>;
		};
		/* i2c functional clock, measured live 13.10 (regprobe): pll 192 mhz
		 * (0x20032644 = 0x1e2) / 8 (0x20033010 sel 4) = 24 mhz */
		i2c_fclk: i2c-fclk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <24000000>;
		};
		/* mmc functional clock, power_resources FUN_800c7fc0 types 0x23/0x24:
		 * pll 192 mhz / (0x20033010 bits 11:10 / 3:2 + 1) = /2 with the 0x4494
		 * symbian leaves, or 38.4 mhz if 0x20033090 bit 1/2 picks it. the
		 * higher one is the safe guess, a lower real rate only slows the card */
		mmc_fclk: mmc-fclk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <96000000>;
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* ARM L220 outer cache (cache id 0x41000486), symbian's ekern keeps it on
		 * and maintains it by pa (+0x7b0/0x770/0x7f0). without this node dma
		 * reads stale ram */
		l2c: cache-controller@20500000 {
			compatible = "arm,l220-cache";
			reg = <0x20500000 0x1000>;
			cache-unified;
			cache-level = <2>;
		};

		/* karap irq/fiq dispatchers + Interrupt:: code, 421 lines */
		intc: interrupt-controller@20400000 {
			compatible = "nokia,rapuyama-intc";
			/* main bank + the 5 gpio/periph secondary banks (0x20033400) */
			reg = <0x20400000 0x4000>, <0x20033400 0x140>;
			interrupt-controller;
			#interrupt-cells = <1>;
		};

		/* ms timer (BindMsTick, irq 242) + free running 32k counter (NKern::FastCounter) */
		timer@20033780 {
			compatible = "nokia,rapuyama-timer";
			reg = <0x20033780 0x40>, <0x20033350 0x8>;
			interrupts = <242>;
			clocks = <&ref_clk>, <&fc_clk>;
			clock-names = "ref", "fc";
		};

		/* clock gates from power_resources.dll, index = PowerResourceManager
		 * resource id (0x11 = EHwClkI2C1 for i2c, 0x1f = BT uart clock), each
		 * one turns on its hw gates. all hang off the i2c fclk for now (only
		 * i2c uses a rate). 0x11 + 0x1f are critical = always on, symbian gates
		 * them when idle and touching those blocks with the clock off kills
		 * the phone (regprobe runs 1+2) */
		cgc: clock-controller@20032f00 {
			compatible = "nokia,rapuyama-cgc";
			reg = <0x20032f00 0x300>;
			clocks = <&i2c_fclk>;
			#clock-cells = <1>;
		};

		/* usb.dll: Mentor MUSB + TI OMAP2430 style otg wrapper at +0x400,
		 * ULPI phy in the Gazoo asic (left as symbian set it up). irq 183 =
		 * core, 215 = dma. off by default, e6-usb.dts turns it on */
		usb_otg: usb@20038800 {
			compatible = "nokia,rapuyama-musb";
			reg = <0x20038800 0x500>;
			interrupts = <183>, <215>;
			interrupt-names = "mc", "dma";
			/* EHwClkDomHSUSB (power domain + gates), EHwClkHSUSB, and
			 * EHwClkI2C0 + EHwClkDspSpi1, which usb.dll also asks for */
			clocks = <&cgc 0x0e>, <&cgc 0x0f>, <&cgc 0x10>, <&cgc 0x21>;
			phys = <&usb_phy>;
			dr_mode = "peripheral";
			status = "disabled";
		};

		/* EPBUSMV.DLL: two TI OMAP1/2420 style mmc controllers, tables at
		 * 0x80164558 (base 0/0x100), 0x80164568 (irq 0xad/0xab), 0x80164578
		 * (power resource 0x23/0x24, named EHwClkASIBT/ASIMusti but these
		 * are the ones EPBUSMV turns on). N8 schematic: microSD on MMC2.
		 * symbian clocks cards at most 24 mhz (min(0x80163b60 = 48, 24)) */
		mmc1: mmc@20032800 {
			compatible = "nokia,rapuyama-mmc", "ti,omap2420-mmc";
			reg = <0x20032800 0x80>;
			interrupts = <173>;
			clocks = <&cgc 0x23>, <&mmc_fclk>;
			clock-names = "ick", "fck";
			bus-width = <4>;
			broken-cd;
			max-frequency = <24000000>;
		};

		mmc2: mmc@20032900 {
			compatible = "nokia,rapuyama-mmc", "ti,omap2420-mmc";
			reg = <0x20032900 0x80>;
			interrupts = <171>;
			clocks = <&cgc 0x24>, <&mmc_fclk>;
			clock-names = "ick", "fck";
			bus-width = <4>;
			max-frequency = <24000000>;
		};

		/* bc02_uart1.PDD, the uart to the bluetooth chip (earlycon only) */
		uart_bt: serial@20025a00 {
			compatible = "nokia,rapuyama-uart";
			reg = <0x20025a00 0x100>;
			interrupts = <99>, <101>;
			clocks = <&cgc 0x1f>;
			current-speed = <115200>;
		};

		/* pmic watchdog over the cbus master + soc counter, symbian left both
		 * running. 3rd reg = soc reset (rebootdriver.ldd: write 2) */
		watchdog@20030700 {
			compatible = "nokia,rapuyama-wdt";
			reg = <0x20030700 0x40>, <0x200336c4 0x4>, <0x20033114 0x4>;
		};

		/* isasw hs i2c port 3, 32 bit registers and explicit clock/pad setup */
		i2c3: i2c@20032500 {
			compatible = "nokia,rapuyama-hs-i2c";
			reg = <0x20032500 0x80>, <0x20033000 0x100>,
			      <0x20031a00 0x40>, <0x2003264c 0x4>;
			clocks = <&cgc 0x13>;
			clock-names = "ick";
			clock-frequency = <100000>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";

			charger: charger@6b {
				compatible = "ti,bq24153";
				reg = <0x6b>;
				monitored-battery = <&battery>;
				ti,usb-charger-detection = <&usb_supply>;
				ti,current-limit = <500>;
				ti,weak-battery-voltage = <3400>;
				ti,battery-regulation-voltage = <4100>;
				ti,charge-current = <550>;
				ti,termination-current = <100>;
				ti,resistor-sense = <68>;
			};
		};

		/* battery from the gazoo adc behind the cbus above (rapuyama-battery.c) */
		battery: battery {
			compatible = "nokia,rapuyama-battery";
			nokia,charger = <&charger>;

			usb_supply: usb {
			};
		};

		/* modem (CMT) link. drives the EM "awake" keepalive that stops the
		 * random 50-210 s warm reset (rapuyama_modem.c). regs, in order:
		 *   0 modem control region (swirq 0x280/4/8 + per-channel resets)
		 *   1 TX byte FIFO (0x40100000 + chan*0x1000, ASIC send FUN_800beac8)
		 *   2 send doorbell (0x401fd800, write channel number)
		 *   3 clock controller (modem-interface bring-up, ecust FUN_800bede4)
		 * line 30 is optional: the irqchip owns the INTC ack (modem_link=1) */
		modem@20040000 {
			compatible = "nokia,rapuyama-modem";
			reg = <0x20040000 0x2000>, <0x40100000 0x1000>,
			      <0x401fd800 0x4>, <0x20032000 0x2000>;
			interrupts = <30>;
			status = "okay";
		};

		/* i2c0.dll: the TI OMAP i2c in the omap2420 layout, but with an 8 bit
		 * DATA reg (ti,omap2420-i2c zeroes every second byte). irq 0x96 */
		i2c0: i2c@20032200 {
			compatible = "nokia,rapuyama-i2c";
			reg = <0x20032200 0x40>;
			interrupts = <150>;
			clocks = <&cgc 0x11>;
			clock-names = "fck";
			clock-frequency = <100000>;	/* 400 kHz: keypad and touch stop answering (22.10.2026) */
			#address-cells = <1>;
			#size-cells = <0>;

			/* keypad chip: id reg 0x80 = 3 -> toshiba tc3589x (keypad_exp.dll
			 * Small25Pin class). driven by our polled rapuyama-keypad, the
			 * mainline tc3589x drivers reset it into a NACKing state.
			 * fifo code = row << 4 | col, mapped live with keyscan.
			 * MATRIX_KEY(row, col, code) = row << 24 | col << 16 | code,
			 * no cpp here so raw numbers. zh/eh keys = ; and ' like the
			 * pc russian layout. calendar gave the home code, power and
			 * the lock slider aren't on the matrix */
			keypad@44 {
				compatible = "nokia,rapuyama-keypad";
				reg = <0x44>;
				keypad,num-rows = <8>;
				keypad,num-columns = <7>;
				linux,keymap = <
					0x00000010 /* q */
					0x00010011 /* w */
					0x00020012 /* e */
					0x00030013 /* r */
					0x00040014 /* t */
					0x00050015 /* y */
					0x00060016 /* u */
					0x0100001e /* a */
					0x0101001f /* s */
					0x01020020 /* d */
					0x01030021 /* f */
					0x01040022 /* g */
					0x01050023 /* h */
					0x01060024 /* j */
					0x0200002c /* z */
					0x0201002d /* x */
					0x0202002e /* c */
					0x0203002f /* v */
					0x02040030 /* b */
					0x02050031 /* n */
					0x02060032 /* m */
					0x03000017 /* i */
					0x03010018 /* o */
					0x03020019 /* p */
					0x03030061 /* ctrl */
					0x030601bd /* call (KEY_PICKUP_PHONE) */
					0x04000025 /* k */
					0x04010026 /* l */
					0x0402000e /* backspace */
					0x04030073 /* volume up */
					0x0404002a /* shift */
					0x040600ac /* home (KEY_HOMEPAGE) */
					0x05000027 /* zh (;) */
					0x05010028 /* eh (') */
					0x0502001c /* enter */
					0x050401be /* end call (KEY_HANGUP_PHONE) */
					0x05050034 /* dot */
					0x05060072 /* volume down */
					0x0600007f /* sym (KEY_COMPOSE) */
					0x06010039 /* space */
					0x060301ad /* contacts (KEY_ADDRESSBOOK) */
					0x060401ae /* messages (KEY_MESSENGER) */
					0x06050033 /* comma */
					0x06060064 /* fn arrow (KEY_RIGHTALT = level 3 in xkb e6) */
					0x07000067 /* up */
					0x0701006c /* down */
					0x07020069 /* left */
					0x0703006a /* right */
					0x07040160 /* center (KEY_OK) */
					0x070600a4 /* play/pause */
				>;
			};

			/* atmel maXTouch, polled: irq gpio 123 polarity is unknown */
			touchscreen@4a {
				compatible = "nokia,rapuyama-mxt";
				reg = <0x4a>;
			};
		};

		/* egpio.dll, 5 in/out banks + 2 output only banks. second reg =
		 * pin irq enable/ack/trigger banks, each pin has its own intc line */
		gpio: gpio@20031900 {
			compatible = "nokia,rapuyama-gpio";
			reg = <0x20031900 0x200>, <0x20033400 0x140>;
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};
	};
};